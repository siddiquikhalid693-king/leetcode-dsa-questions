//Unique 3-Digit Even Numbers

from collections import Counter

class Solution:
    def totalNumbers(self, digits):  # Changed function name to match the platform
        digit_count = Counter(digits)
        valid_count = 0
        
        for num in range(100, 1000, 2):
            s_num = str(num)
            num_count = Counter(s_num)
            
            if all(num_count[d] <= digit_count[int(d)] for d in s_num):
                valid_count += 1
                
        return valid_count
