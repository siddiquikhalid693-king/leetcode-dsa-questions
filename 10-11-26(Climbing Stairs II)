//Climbing Stairs II

class Solution(object):
    def climbStairs(self, n, costs):
        # Initialize the dp table with infinity
        dp = [float('inf')] * (n + 1)
        dp[0] = 0
        
        # Adjust costs to be 1-indexed by adding a dummy element at index 0
        extended_costs = [0] + costs
        
        for i in range(1, n + 1):
            # Jump from i - 1
            if i >= 1:
                dp[i] = min(dp[i], dp[i-1] + extended_costs[i] + 1)
            # Jump from i - 2
            if i >= 2:
                dp[i] = min(dp[i], dp[i-2] + extended_costs[i] + 4)
            # Jump from i - 3
            if i >= 3:
                dp[i] = min(dp[i], dp[i-3] + extended_costs[i] + 9)
                
        return dp[n]
