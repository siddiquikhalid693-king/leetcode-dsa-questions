//Find X Value of Array I

class Solution:
    def resultArray(self, nums, k):
        result = [0] * k
        dp = [0] * k

        for num in nums:
            new_dp = [0] * k

            # Start a new subarray
            remainder = num % k
            new_dp[remainder] += 1

            # Extend previous subarrays
            for r in range(k):
                if dp[r] > 0:
                    new_remainder = (r * remainder) % k
                    new_dp[new_remainder] += dp[r]

            dp = new_dp

            # Add subarrays ending at this position
            for r in range(k):
                result[r] += dp[r]

        return result
