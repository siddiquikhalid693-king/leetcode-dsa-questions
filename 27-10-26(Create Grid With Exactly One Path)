//Create Grid With Exactly One Path

class Solution(object):
    def createGrid(self, m, n):
        grid = [['#'] * n for _ in range(m)]
        i = j = 0
        grid[0][0] = '.'
        step = 0  # even: move right, odd: move down
        while i < m - 1 or j < n - 1:
            if i == m - 1:
                j += 1
            elif j == n - 1:
                i += 1
            elif step % 2 == 0:
                j += 1
            else:
                i += 1
            grid[i][j] = '.'
            step += 1
        return [''.join(row) for row in grid]
