//Removing Minimum and Maximum From Array



class Solution(object):
    def minimumDeletions(self, nums):
        n = len(nums)
        if n <= 2:
            return n
            
        # Find the indices of the min and max elements
        min_idx = nums.index(min(nums))
        max_idx = nums.index(max(nums))
        
        # Ensure i is the smaller index and j is the larger index
        i = min(min_idx, max_idx)
        j = max(min_idx, max_idx)
        
        # Option 1: Delete both from the front
        opt1 = j + 1
        
        # Option 2: Delete both from the back
        opt2 = n - i
        
        # Option 3: Delete i from the front, j from the back
        opt3 = (i + 1) + (n - j)
        
        return min(opt1, opt2, opt3)
