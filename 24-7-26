//Number of Unique XOR Triplets I

class Solution {
    public int uniqueXorTriplets(int[] nums) {
        int n = nums.length;

        if (n <= 2) {
            return n;
        }

        int power = 1;

        while (power <= n) {
            power *= 2;
        }

        return power;
    }
}


