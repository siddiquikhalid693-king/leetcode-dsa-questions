//Stone Game V

class Solution(object):
    def stoneGameV(self, stoneValue):
        n = len(stoneValue)
        if n <= 1:
            return 0
            
        # Prefix sum array to get subarray sums in O(1)
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i + 1] = prefix[i] + stoneValue[i]
            
        # dp[i][j] stores the maximum score for subarray stoneValue[i...j]
        dp = [[0] * n for _ in range(n)]
        
        # max_left[i][j] tracks max(dp[i][k] + sum(i...k)) for k from i to j
        max_left = [[0] * n for _ in range(n)]
        # max_right[i][j] tracks max(dp[k+1][j] + sum(k+1...j)) for k from i to j
        max_right = [[0] * n for _ in range(n)]
        
        # Initialize base cases for single element subarrays
        for i in range(n):
            max_left[i][i] = stoneValue[i]
            max_right[i][i] = stoneValue[i]
            
        # Maintain independent split markers for each start index 'i'
        mid_ptr = [i for i in range(n)]
        
        for length in range(2, n + 1):
            for i in range(n - length + 1):
                j = i + length - 1
                
                total_sum = prefix[j + 1] - prefix[i]
                # Shift mid_ptr for this 'i' as long as the left side sum is strictly less than half
                while (prefix[mid_ptr[i] + 1] - prefix[i]) * 2 < total_sum:
                    mid_ptr[i] += 1
                
                mid = mid_ptr[i]
                
                # Case 1: Split points from i to mid - 1 (where left_sum < right_sum)
                res1 = max_left[i][mid - 1] if mid - 1 >= i else 0
                
                # Case 2: Split points from mid + 1 to j (where left_sum > right_sum)
                res2 = max_right[mid + 1][j] if mid + 1 <= j else 0
                
                # Case 3: The exact pivot index 'mid' itself
                res3 = 0
                if (prefix[mid + 1] - prefix[i]) * 2 == total_sum:
                    # Perfect balance: Alice picks the optimal side
                    res3 = max(max_left[i][mid], max_right[mid + 1][j])
                else:
                    # Left side sum is greater than right side sum: Bob discards the left
                    right_sum = prefix[j + 1] - prefix[mid + 1]
                    res3 = right_sum + dp[mid + 1][j] if mid + 1 <= j else 0
                
                dp[i][j] = max(res1, res2, res3)
                
                # Update prefix maximum trackers for future interval calculations
                max_left[i][j] = max(max_left[i][j - 1], dp[i][j] + total_sum)
                max_right[i][j] = max(max_right[i + 1][j], dp[i][j] + total_sum)
                
        return dp[0][n - 1]
