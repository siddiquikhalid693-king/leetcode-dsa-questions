//Count Commas in Range

class Solution(object):
    def countCommas(self, n):
        total = 0
        d = 1
        while True:
            lower = 1 if d == 1 else 10 ** (d - 1)
            upper = 10 ** d - 1
            if lower > n:
                break
            count = min(n, upper) - lower + 1
            commas_per_number = (d - 1) // 3
            total += count * commas_per_number
            d += 1
        return total
