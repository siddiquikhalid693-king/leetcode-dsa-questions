//Shortest Path With At Most K Consecutive Identical Characters

import heapq

class Solution:
    def shortestPath(self, n, edges, labels, k):
        adj = [[] for _ in range(n)]
        for u, v, w in edges:
            adj[u].append((v, w))

        INF = float('inf')
        K = k + 1
        # dist[node * K + run]
        dist = [INF] * (n * K)
        dist[1] = 0  # node 0, run 1
        pq = [(0, 0, 1)]  # (distance, node, run)

        while pq:
            d, u, r = heapq.heappop(pq)
            if d > dist[u * K + r]:
                continue
            if u == n - 1:
                return d
            lu = labels[u]
            for v, w in adj[u]:
                if labels[v] == lu:
                    nr = r + 1
                    if nr > k:
                        continue
                else:
                    nr = 1
                nd = d + w
                idx = v * K + nr
                if nd < dist[idx]:
                    dist[idx] = nd
                    heapq.heappush(pq, (nd, v, nr))

        return -1
