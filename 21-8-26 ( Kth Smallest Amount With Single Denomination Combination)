// Kth Smallest Amount With Single Denomination Combination

import fractions

class Solution(object):
    def findKthSmallest(self, coins, k):
        n = len(coins)
        subsets = []
        
        # Precompute LCMs for all subsets
        for i in range(1, 1 << n):
            current_lcm = 1
            count = 0
            for j in range(n):
                if (i >> j) & 1:
                    # In Python 2, use fractions.gcd instead of math.gcd
                    current_lcm = (current_lcm * coins[j]) // fractions.gcd(current_lcm, coins[j])
                    count += 1
            
            sign = 1 if count % 2 == 1 else -1
            subsets.append((current_lcm, sign))
            
        # Helper function to count unique multiples <= m
        def count_multiples(m):
            total = 0
            for lcm, sign in subsets:
                total += sign * (m // lcm)
            return total

        # Binary search range
        low = 1
        high = min(coins) * k
        
        while low < high:
            mid = (low + high) // 2
            if count_multiples(mid) < k:
                low = mid + 1
            else:
                high = mid
                
        return low
