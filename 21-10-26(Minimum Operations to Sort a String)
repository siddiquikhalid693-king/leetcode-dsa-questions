//Minimum Operations to Sort a String

class Solution(object):
    def minOperations(self, s):
        n = len(s)

        # already sorted
        if all(s[i] <= s[i + 1] for i in range(n - 1)):
            return 0

        # unsorted with n == 2: only single-char substrings are allowed
        if n == 2:
            return -1

        mn, mx = min(s), max(s)

        # one end is already in its final place
        if s[0] == mn or s[-1] == mx:
            return 1

        # the max is alone at the front and the min is alone at the back
        if s[0] == mx and s[-1] == mn and s.count(mx) == 1 and s.count(mn) == 1:
            return 3

        return 2
