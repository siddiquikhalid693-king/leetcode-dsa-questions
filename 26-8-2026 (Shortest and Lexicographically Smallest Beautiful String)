//Shortest and Lexicographically Smallest Beautiful String

class Solution(object):
    def shortestBeautifulSubstring(self, s, k):
        if s.count('1') < k:
            return ""
        
        n = len(s)
        ans = ""
        min_len = float('inf')
        
        l = 0
        ones = 0
        
        for r in range(n):
            if s[r] == '1':
                ones += 1
                
            while ones == k:
                if s[l] == '1':
                    current_len = r - l + 1
                    current_sub = s[l:r+1]
                    
                    if current_len < min_len:
                        min_len = current_len
                        ans = current_sub
                    elif current_len == min_len:
                        if current_sub < ans:
                            ans = current_sub
                    
                    ones -= 1
                l += 1
                
        return ans
